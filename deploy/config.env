# ============================================================================
#  streamer_codev8.0 一键部署配置
#  ---------------------------------------------------------------------------
#  【客户/部署工程师】只需修改本文件，然后执行  ./deploy/start.sh
#  ===========================================================================

# ---- 输入源 ----
# 真机：/dev/video11（MIPI 广角）+ /dev/video20（USB）
# 调试：填视频文件路径即可自动进入视频回放模式（如 /home/xxx/input1.mp4）
SOURCE0="/dev/video11"
SOURCE1="/dev/video20"

# ---- RTMP 推流地址（给上位机/监控端） ----
RTMP_URL="rtmp://192.168.1.30:1935/live/app"

# ---- 视频参数 ----
WIDTH="1280"
HEIGHT="720"
FPS="30"
# 运行秒数：0 = 无限运行（工业部署建议 0）
RUN_SECONDS="0"

# ---- 模型路径（相对项目根目录） ----
MODEL_YOLO="model/yolov5s.rknn"

# ---- Qwen 旁路风险分析 ----
# 1 = 启用（需已编译 QWEN_ENABLED 且模型已就位，模型已打进部署包 model/ 目录）
# 0 = 关闭（旁路不加载，YOLO/UNet/推流完全不受影响）
QWEN="0"
# 默认使用最轻量 Qwen3.5-0.8B（1.3GB RAM，21.6 tok/s，RK3588 实测）
# 备选：Qwen3-VL-2B（3.1GB，11.5 tok/s）—— 需 rkllm 1.2.3 + 编译时 -DQWEN_RKLLM_130=OFF
QWEN_LLM="model/qwen3.5-0.8b_w8a8_rk3588.rkllm"
QWEN_VISION="model/qwen3.5-0.8b-vision_rk3588.rknn"

# ---- RKLLM 运行时库目录（编译期可选，仅启用 Qwen 时需要）----
# 指向 rknn-llm 安装目录（含 include/rkllm.h 与 lib/librkllmrt.so）
# 0.8B 需要 rkllm-runtime 1.3.0；2B 需要 1.2.3
# 留空 = 不使用 RKLLM（Qwen 编译为空壳）
RKLLM_DIR=""
